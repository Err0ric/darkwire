# Railway injects DATABASE_URL and PORT. These are the local defaults.
DATABASE_URL=postgresql://darkwire:darkwire@localhost:5432/darkwire
PORT=8000
INGEST_INTERVAL_MINUTES=15
INGEST_ENABLED=true
ENRICH_INTERVAL_MINUTES=15
# Optional: 50 NVD requests / 30 s instead of 5
NVD_API_KEY=
CORS_ORIGINS=http://localhost:3000,https://darkwire.tech
CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.vercel\.app

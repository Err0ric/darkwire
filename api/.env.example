# Railway injects DATABASE_URL and PORT. These are the local defaults (docker-compose.yml).
DATABASE_URL=postgresql://darkwire:darkwire@localhost:5432/darkwire
PORT=8000
INGEST_INTERVAL_MINUTES=15
INGEST_ENABLED=true
ENRICH_INTERVAL_MINUTES=15
# Optional: 50 NVD requests / 30 s instead of 5.
NVD_API_KEY=
# Optional: row summaries and workaround sentences via Claude Haiku. Unset = no summaries.
ANTHROPIC_API_KEY=
# Optional: lifts the public 100-row limit and allows /feed?all_sources (python -m app.audit).
AUDIT_TOKEN=
# Optional: server-rendered page requests carrying it skip the per-IP bucket. Same value as
# API_SERVER_TOKEN in the web app.
SSR_TOKEN=
